'inbox:Work with named inboxes' \
'attachment:Work with message attachments' \
'provider:Inspect and configure providers' \
'config:Inspect and update local configuration' \
'ls:Alias for \`message list\`' \
'read:Alias for \`message read\`' \
'latest:Alias for \`message latest\`' \
'new:Alias for \`inbox create\`' \
